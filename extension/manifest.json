{
  "manifest_version": 3,
  "name": "vaultr",
  "description": "Fill the focused field with a value from HashiCorp Vault or OpenBao, through the vaultr command line tool.",
  "version": "0.0.0",
  "key": "",
  "permissions": ["activeTab", "scripting", "nativeMessaging"],
  "background": {
    "service_worker": "background.js",
    "scripts": ["fill.js", "background.js"]
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "vaultr: fill the focused field",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png"
    }
  },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+V" },
      "description": "Open vaultr to fill the focused field"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "vaultr@rnsc.be",
      "strict_min_version": "140.0",
      "data_collection_permissions": { "required": ["none"] }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  }
}
